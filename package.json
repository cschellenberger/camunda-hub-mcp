{
  "name": "@cschellenberger/camunda-hub-mcp",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Community MCP server for prompt-driven BPMN authoring through the Camunda Hub API.",
  "type": "module",
  "license": "MIT",
  "author": "Cody Schellenberger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cschellenberger/camunda-hub-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/cschellenberger/camunda-hub-mcp/issues"
  },
  "homepage": "https://github.com/cschellenberger/camunda-hub-mcp#readme",
  "bin": {
    "camunda-hub-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "pack:check": "npm pack --dry-run --ignore-scripts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
